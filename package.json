    "@mui/material": "^9.1.2",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.18.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.10.0",
